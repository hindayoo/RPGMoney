        const useSakura = () => { useEffect(() => { const c = document.getElementById('sakura-container'); if(!c) return; const i = setInterval(() => { const p = document.createElement('div'); p.classList.add('petal'); p.style.width = Math.random()*10+5+'px'; p.style.height=p.style.width; p.style.left=Math.random()*100+'%'; p.style.animationDuration=Math.random()*3+5+'s'; c.appendChild(p); setTimeout(()=>p.remove(),8000); }, 400); return ()=>clearInterval(i); }, []); };

        // --- COMPONENTS ---
        const Keypad = ({ value, onChange, onConfirm, onClose, label }) => {
            const handlePress = (key) => {
                if (key === 'OK') onConfirm();
                else if (key === 'AC') onChange('');
                else if (key === 'DEL') onChange(value.toString().slice(0, -1));
                else { const last = value.toString().slice(-1); if (['+','-','*','/'].includes(key) && ['+','-','*','/'].includes(last)) return; onChange(value + key); }
            };
            const calculate = () => { try { if (!/^[0-9+\-*/.]+$/.test(value)) return value; return new Function('return ' + value)().toString(); } catch { return value; } };
            const preview = useMemo(() => calculate(), [value]);
            return (
                <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] flex flex-col justify-end animate-[fadeIn_0.2s]">
                    <div className="bg-sakura-light dark:bg-dark-card border-t-4 border-wood rounded-t-[2.5rem] p-6 shadow-2xl pb-safe">
                        <div className="flex justify-between items-center mb-2"><h3 className="font-bold text-lg text-wood dark:text-sakura-base font-pixel tracking-widest">{label}</h3><button onClick={onClose} className="p-2 bg-white/50 dark:bg-gray-700 rounded-full active:scale-95"><Icon name="X" size={20}/></button></div>
                        <div className="bg-[#e0e7da] dark:bg-black/40 p-4 rounded-3xl mb-4 text-right flex flex-col justify-center h-24 border-4 border-gray-300 dark:border-gray-600 shadow-inner">
                            <div className="text-sm text-gray-500 dark:text-gray-400 mb-1 h-5 overflow-hidden font-mono">{value.match(/[+\-*/]/) ? value : ''}</div>
                            <div className="text-4xl font-mono font-bold text-gray-800 dark:text-white truncate">{value || '0'}</div>
                            {value !== preview && <div className="text-sm text-sakura-dark font-bold">= {preview}</div>}
                        </div>
                        <div className="grid grid-cols-4 gap-3">
                            <button onClick={()=>handlePress('AC')} className="keypad-btn btn-op text-red-500">AC</button><button onClick={()=>handlePress('/')} className="keypad-btn btn-op text-xl">÷</button><button onClick={()=>handlePress('*')} className="keypad-btn btn-op text-xl">×</button><button onClick={()=>handlePress('DEL')} className="keypad-btn btn-op text-red-400"><Icon name="Backspace" size={24}/></button>
                            {[7,8,9,'-', 4,5,6,'+', 1,2,3].map(k => (<button key={k} onClick={() => handlePress(k)} className={`keypad-btn ${typeof k === 'string' ? 'btn-op text-2xl' : 'btn-num'}`}>{k}</button>))}
                            <button key="OK" onClick={() => onChange(preview)} className="keypad-btn btn-action row-span-2 flex items-center justify-center"><Icon name="Check" size={32}/></button>
                            <button onClick={() => handlePress(0)} className="keypad-btn btn-num col-span-2">0</button><button onClick={() => handlePress('.')} className="keypad-btn btn-num">.</button>
                        </div>
                        <button onClick={onConfirm} className="w-full py-4 mt-4 bg-wood text-white rounded-3xl font-bold shadow-[0_4px_0_0_#5D4037] active:shadow-none active:translate-y-1 font-pixel text-xl tracking-widest border-2 border-[#5D4037]">CONFIRM</button>
                    </div>
                </div>
            );
        };

        const CategoryManager = ({ categories, onSave, onClose }) => {
            const [newCat, setNewCat] = useState({ label: '', icon: 'Star', color: '#fca5a5' });
            const handleAdd = () => { if(!newCat.label) return; onSave([...categories, { ...newCat, id: 'c_'+Date.now() }]); setNewCat({ label: '', icon: 'Star', color: '#fca5a5' }); };
            const handleDelete = (id) => { if(confirm('Delete?')) onSave(categories.filter(c => c.id !== id)); };
            return (
                <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-[70] flex flex-col justify-center px-6">
                    <div className="bg-white dark:bg-dark-card rounded-3xl p-6 shadow-2xl max-h-[80vh] overflow-y-auto">
                        <div className="flex justify-between mb-4"><h3 className="font-bold text-lg dark:text-white">管理類別</h3><button onClick={onClose} className="dark:text-white"><Icon name="X"/></button></div>
                        <div className="grid grid-cols-4 gap-2 mb-4">
                            {categories.map(c => (<div key={c.id} className="flex flex-col items-center p-2 rounded-xl bg-gray-50 dark:bg-white/10 relative"><div className="w-8 h-8 rounded-full flex items-center justify-center mb-1" style={{backgroundColor: c.color}}><Icon name={c.icon} size={14} color="white"/></div><span className="text-[9px] dark:text-gray-300 truncate w-full text-center">{c.label}</span>{!['bf','lunch','dinner','transport'].includes(c.id) && <button onClick={()=>handleDelete(c.id)} className="absolute -top-1 -right-1 bg-red-500 text-white rounded-full p-0.5"><Icon name="X" size={8}/></button>}</div>))}
                        </div>
                        <div className="border-t pt-4 dark:border-gray-700">
                            <h4 className="text-xs font-bold mb-2 dark:text-gray-400">新增類別</h4>
                            <input type="text" placeholder="名稱" value={newCat.label} onChange={e=>setNewCat({...newCat, label:e.target.value})} className="w-full bg-gray-100 dark:bg-black/30 p-2 rounded-lg mb-2 text-sm dark:text-white"/>
                            <div className="flex gap-2 overflow-x-auto pb-2 mb-2 no-scrollbar">{AVAILABLE_ICONS.map(i => <button key={i} onClick={()=>setNewCat({...newCat, icon:i})} className={`p-2 rounded-lg ${newCat.icon===i?'bg-sakura-light border border-sakura-dark':''}`}><Icon name={i} size={16} className="text-gray-500"/></button>)}</div>
                            <div className="flex gap-2 overflow-x-auto pb-2 mb-2 no-scrollbar">{AVAILABLE_COLORS.map(c => <button key={c} onClick={()=>setNewCat({...newCat, color:c})} className={`w-6 h-6 rounded-full flex-shrink-0 ${newCat.color===c?'ring-2 ring-black':''}`} style={{backgroundColor:c}}/>)}</div>
                            <button onClick={handleAdd} className="w-full py-3 bg-sakura-dark text-white rounded-xl font-bold text-sm">新增</button>
                        </div>
                    </div>
                </div>
            );
        };

        const App = () => {
            useSakura();
            const [data, setData] = useState({ user: null, accounts: [], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES });
            const [loading, setLoading] = useState(true);
            const [view, setView] = useState('adventure');
            const [subView, setSubView] = useState('main');
            const [modalOpen, setModalOpen] = useState(false);
            const [assetModalOpen, setAssetModalOpen] = useState(false);
            const [catManagerOpen, setCatManagerOpen] = useState(false);
            const [keypadOpen, setKeypadOpen] = useState(false);
            const [keypadTarget, setKeypadTarget] = useState(null); 
            const [tempValue, setTempValue] = useState('');
            const [txForm, setTxForm] = useState({ amount: '', note: '', type: 'expense', category: 'bf', accountId: '' });
            const [assetForm, setAssetForm] = useState({ id: null, name: '', currency: 'HKD', balance: '', type: 'cash' });
            const [isRegistering, setIsRegistering] = useState(false);
            const [loginAccount, setLoginAccount] = useState('');
            const [loginPass, setLoginPass] = useState('');
            const [regName, setRegName] = useState('');
            const [showPass, setShowPass] = useState(false);
            const [theme, setTheme] = useState(localStorage.getItem('gw_theme') || 'light');
            const [lang, setLang] = useState(localStorage.getItem('gw_lang') || 'zh');
            const [rates, setRates] = useState({});
            const [baseAmount, setBaseAmount] = useState('100');
            const t = (key) => TRANSLATIONS[lang][key] || key;

            useEffect(() => { if (theme === 'dark') document.documentElement.classList.add('dark'); else document.documentElement.classList.remove('dark'); localStorage.setItem('gw_theme', theme); }, [theme]);
            useEffect(() => { localStorage.setItem('gw_lang', lang); }, [lang]);

            const addLog = (type, msg) => { const newLog = { id: Date.now(), date: new Date().toISOString(), type, msg }; return [newLog, ...(data.logs || [])].slice(0, 50); };
            const checkDailyReset = (currentData) => { 
                if(!currentData.categories || currentData.categories.length === 0) currentData.categories = DEFAULT_CATEGORIES;
                setData(currentData); 
            };
            const loadLocalData = () => { 
                try {
                    const localData = JSON.parse(localStorage.getItem('gw_v29_data'));
                    if (localData) checkDailyReset(localData);
                    else setData({ user: null, accounts: [], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES });
                } catch(e) { console.error("Local Error", e); }
                setLoading(false); 
            };
            const saveData = (newData) => { 
                setData(newData); 
                if (!window.isOffline && window.firebase && window.firebase.auth.currentUser) {
                    window.firebase.doc(window.firebase.db, "users", window.firebase.auth.currentUser.uid).setDoc(newData).catch(console.error);
                }
                localStorage.setItem('gw_v29_data', JSON.stringify(newData)); 
            };

            useEffect(() => { 
                const t = setTimeout(() => { if (loading) { document.getElementById('loading-screen').style.display = 'none'; document.getElementById('root').classList.remove('hidden'); } }, 2000); 
                if (window.isOffline || !window.firebase) { loadLocalData(); return; } 
                
                const unsub = window.firebase.onAuthStateChanged(window.firebase.auth, (u) => { 
                    clearTimeout(t); 
                    if (u) { 
                        window.firebase.onSnapshot(window.firebase.doc(window.firebase.db, "users", u.uid), (d) => { 
                            if (d.exists()) checkDailyReset(d.data()); 
                            else { 
                                const init = { user: { uid: u.uid, name: u.displayName||'Hero', level: 1, exp: 0, title: 'Novice' }, accounts: [{ id: Date.now(), name: 'Wallet', currency: 'HKD', balance: 0, type: 'cash' }], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES }; 
                                window.firebase.setDoc(window.firebase.doc(window.firebase.db, "users", u.uid), init); setData(init); 
                            } 
                            setLoading(false); 
                        }, (err) => { console.error(err); loadLocalData(); }); 
                    } else loadLocalData(); 
                }); 
                return () => { unsub(); clearTimeout(t); } 
            }, []);

            useEffect(() => { if (view === 'exchange' || assetModalOpen) fetch('https://open.er-api.com/v6/latest/HKD').then(r=>r.json()).then(d=>setRates(d.rates)).catch(console.error); }, [view, assetModalOpen]);

            const handleAuth = async () => { 
                if (window.isOffline) return alert("Offline Mode");
                const email = loginAccount.trim() + "@sakurarpg.com"; 
                try { 
                    if (isRegistering) {
                        if (!/^[a-zA-Z0-9]+$/.test(loginAccount)) return alert(t('acc_alert')); 
                        const cred = await window.firebase.createUserWithEmailAndPassword(window.firebase.auth, email, loginPass); 
                        await window.firebase.updateProfile(cred.user, { displayName: regName }); 
                        location.reload(); 
                    } else await window.firebase.signInWithEmailAndPassword(window.firebase.auth, email, loginPass); 
                } catch (e) { alert(e.message); } 
            };
            const logout = () => { if(window.firebase && window.firebase.auth) window.firebase.signOut(window.firebase.auth); location.reload(); };
            const handleAvatarUpload = async (e) => { const file = e.target.files[0]; if(file){ const b64 = await resizeImage(file); saveData({...data, user: {...data.user, photo: b64}}); } };
            
            const openKeypad = (target, initVal) => { setKeypadTarget(target); setTempValue(initVal ? initVal.toString() : ''); setKeypadOpen(true); };
            const confirmKeypad = () => {
                const val = tempValue || '0';
                let finalVal = val;
                try { if (/^[0-9+\-*/.]+$/.test(val)) finalVal = new Function('return ' + val)().toString(); } catch {}
                if (keypadTarget === 'tx') setTxForm(prev => ({ ...prev, amount: finalVal }));
                else if (keypadTarget === 'asset') setAssetForm(prev => ({ ...prev, balance: finalVal }));
                else if (keypadTarget === 'exchange') setBaseAmount(finalVal);
                setKeypadOpen(false);
            };

            const addTransaction = () => {
                if(!txForm.amount || !txForm.accountId) return alert(t('missing_info'));
                const amt = parseFloat(txForm.amount);
                const acc = data.accounts.find(a => a.id == txForm.accountId);
                const newTx = { id: Date.now(), date: new Date().toISOString(), ...txForm, amount: amt, accountName: acc.name, currency: acc.currency };
                const newAccs = data.accounts.map(a => a.id == acc.id ? { ...a, balance: txForm.type === 'expense' ? a.balance - amt : a.balance + amt } : a);
                let newExp = data.user.exp + 5; let newLv = data.user.level; if (newExp >= newLv * 100) { newLv++; newExp -= (newLv-1)*100; }
                const catLabel = (data.categories && data.categories.find(c => c.id === txForm.category)?.label) || 'Unknown';
                const newLogs = addLog(txForm.type==='expense'?'finance_out':'finance_in', `${txForm.type==='expense'?'Out':'In'} ${amt} (${catLabel})`);
                saveData({ ...data, user: {...data.user, exp: newExp, level: newLv}, accounts: newAccs, transactions: [newTx, ...data.transactions], logs: newLogs });
                setModalOpen(false);
            };

            const saveAsset = () => {
                if (!assetForm.name || assetForm.balance === '') return alert(t('missing_info'));
                let newAccs = [...data.accounts];
                if (assetForm.id) newAccs = newAccs.map(a => a.id === assetForm.id ? { ...assetForm, balance: parseFloat(assetForm.balance) } : a);
                else newAccs.push({ ...assetForm, id: Date.now(), balance: parseFloat(assetForm.balance) });
                saveData({ ...data, accounts: newAccs });
                setAssetModalOpen(false);
            };
            const deleteAsset = () => { if (confirm(t('confirmDelete'))) { const newAccs = data.accounts.filter(a => a.id !== assetForm.id); saveData({ ...data, accounts: newAccs }); setAssetModalOpen(false); } };
            const toggleLang = () => setLang(l => l==='zh'?'en':l==='en'?'ja':'zh');
            const toggleTheme = () => setTheme(t => t==='dark'?'light':'dark');
            const guardian = useMemo(() => { if (!data.user) return GUARDIAN_STAGES[0]; return GUARDIAN_STAGES.findLast(s => data.user.level >= s.level) || GUARDIAN_STAGES[0]; }, [data.user]);

            useEffect(() => { if (!loading) document.getElementById('loading-screen').style.display = 'none'; document.getElementById('root').classList.remove('hidden'); }, [loading]);
            if (loading) return null;

            if (!data.user) return ( <div className="h-[100dvh] flex flex-col items-center justify-center p-6 animate-[fadeIn_0.5s] overflow-y-auto"><div className="text-6xl mb-6 animate-float">🛡️</div><h1 className="text-2xl font-bold text-ink dark:text-white mb-8 font-pixel tracking-widest text-center">{t('login_title')}</h1><div className="w-full max-w-sm glass p-8 rounded-[2.5rem] shadow-2xl flex flex-col gap-5 dark:text-gray-200 border-4 border-sakura-base/30"><div className="flex bg-white/50 dark:bg-black/20 rounded-full p-1"><button onClick={()=>setIsRegistering(false)} className={`flex-1 py-2 rounded-full text-xs font-bold transition-all ${!isRegistering ? 'bg-sakura-dark text-white shadow' : 'text-gray-500'}`}>{t('login_btn')}</button><button onClick={()=>setIsRegistering(true)} className={`flex-1 py-2 rounded-full text-xs font-bold transition-all ${isRegistering ? 'bg-sakura-dark text-white shadow' : 'text-gray-500'}`}>{t('register_btn')}</button></div>{isRegistering && <input type="text" placeholder="Nickname" value={regName} onChange={e=>setRegName(e.target.value)} className="w-full bg-gray-50 dark:bg-black/30 p-4 rounded-2xl outline-none font-bold mt-1 shadow-inner dark:text-white dark:placeholder-gray-500"/>}<input type="text" placeholder="ID (A-Z, 0-9)" value={loginAccount} onChange={e=>setLoginAccount(e.target.value)} className="w-full bg-gray-50 dark:bg-black/30 p-4 rounded-2xl outline-none font-bold mt-1 shadow-inner dark:text-white dark:placeholder-gray-500"/><div className="relative mt-1"><input type={showPass ? "text" : "password"} value={loginPass} onChange={e=>setLoginPass(e.target.value)} className="w-full bg-gray-50 dark:bg-black/30 p-4 rounded-2xl outline-none font-bold shadow-inner dark:text-white dark:placeholder-gray-500" placeholder="Password"/><button onClick={()=>setShowPass(!showPass)} className="absolute right-4 top-4 opacity-50"><Icon name={showPass?'EyeOff':'Eye'} size={20}/></button></div><button onClick={handleAuth} className="w-full py-4 bg-sakura-dark text-white rounded-2xl font-bold shadow-lg active:scale-95 transition-transform text-lg mt-2">{isRegistering ? t('register_title') : t('login_btn')}</button><div className="text-center mt-2"><p className="text-xs text-gray-400 cursor-pointer hover:text-sakura-dark" onClick={()=>setIsRegistering(!isRegistering)}>{isRegistering ? t('have_acc') : t('new_user')}</p>{isRegistering && <p className="text-[10px] text-red-300 mt-1">*{t('name_alert')}</p>}</div></div><button onClick={() => saveData({...data, user: {name:'Guest', level:1, exp:0, title:'Novice'}})} className="mt-8 text-xs text-gray-400 underline">{t('guest')}</button></div> );

            return (
                <div className="flex flex-col h-[100dvh] relative z-10 text-ink dark:text-dark-text overflow-hidden">
                    <header className="px-4 pt-12 pb-2 flex justify-between items-center bg-white/60 dark:bg-black/40 sticky top-0 z-20 backdrop-blur-md border-b border-white/50 dark:border-white/10 shrink-0">
                        <div className="flex items-center gap-3">
                            <label className="relative cursor-pointer avatar-glow"><div className="w-11 h-11 rounded-full bg-white dark:bg-gray-700 border-2 border-sakura-base overflow-hidden shadow-md flex items-center justify-center text-xl">{data.user.photo ? <img src={data.user.photo} className="w-full h-full object-cover"/> : "👤"}</div><input type="file" accept="image/*" onChange={handleAvatarUpload} className="hidden"/></label>
                            <div><div className="flex items-center gap-2"><h1 className="font-bold text-sm dark:text-white">{data.user.name}</h1><span className="text-[9px] bg-sakura-dark text-white px-1.5 rounded-full">Lv.{data.user.level}</span></div><div className="text-[10px] text-sakura-accent font-bold opacity-80">{data.user.title}</div></div>
                        </div>
                        <div className="flex gap-2">
                            {window.firebase && window.firebase.auth.currentUser ? <span className="w-2 h-2 bg-green-500 rounded-full self-center"></span> : <span className="w-2 h-2 bg-gray-400 rounded-full self-center"></span>}
                            <button onClick={toggleLang} className="w-9 h-9 bg-white/50 dark:bg-black/30 rounded-full flex items-center justify-center shadow-sm border border-white/50 text-[10px] font-bold active:scale-95 transition-transform dark:text-white">{lang.toUpperCase()}</button><button onClick={toggleTheme} className="w-9 h-9 bg-white/50 dark:bg-black/30 rounded-full flex items-center justify-center shadow-sm border border-white/50 active:scale-95 transition-transform dark:text-white"><Icon name={theme==='dark'?'Sun':'Moon'} size={16}/></button><button onClick={logout} className="w-9 h-9 bg-red-100/80 dark:bg-red-900/30 text-red-500 rounded-full flex items-center justify-center shadow-sm border border-white/50 active:scale-95 transition-transform"><Icon name="LogOut" size={16}/></button></div>
                    </header>

                    <main className="flex-1 overflow-y-auto no-scrollbar pb-24 p-4 space-y-5">
                        {view === 'adventure' && (
                            <div className="animate-[fadeIn_0.5s] space-y-5">
                                <div className="glass p-4 rounded-3xl flex items-center justify-between"><div className="w-full"><div className="flex justify-between text-xs font-bold opacity-60 mb-1 dark:text-gray-300"><span>NEXT LEVEL</span><span>{data.user.exp} / {data.user.level * 100}</span></div><div className="w-full h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden"><div className="h-full bg-gradient-to-r from-sakura-base to-sakura-accent transition-all duration-700" style={{width: `${(data.user.exp / (data.user.level*100))*100}%`}}></div></div></div></div>
                                <div><h3 className="font-bold opacity-60 text-sm mb-2 flex items-center gap-1 dark:text-gray-300"><Icon name="Star" size={14}/> {t('upgrade')}</h3><div className="grid grid-cols-3 gap-2">{TALENTS.map((t,i) => (<div key={i} className="glass p-2 rounded-2xl flex flex-col items-center justify-center h-20 bg-white/30 dark:bg-black/30 active:scale-95 transition-transform"><div className={`w-8 h-8 rounded-full flex items-center justify-center mb-1 ${t.color}`}><Icon name={t.icon} size={16}/></div><span className="text-[10px] font-bold opacity-80 dark:text-gray-300">{t.name}</span></div>))}</div></div>
                                <div className="glass p-6 rounded-[2.5rem] relative text-center border-sakura-base/50"><div className="text-8xl animate-float filter drop-shadow-xl mb-4 font-pixel">{guardian.emoji}</div><div className="bg-white/50 dark:bg-black/40 rounded-xl p-3 border border-white/50 text-left mb-3"><div className="flex justify-between items-center mb-1"><h2 className="text-sm font-bold font-pixel dark:text-white">{guardian.name}</h2><span className="text-[9px] bg-sakura-dark text-white px-1 rounded font-pixel">Lv.{data.user.level}</span></div><p className="text-[10px] opacity-70 font-pixel leading-tight dark:text-gray-300">{guardian.desc}</p></div></div>
                                <div><div className="flex justify-between items-center mb-2"><h3 className="font-bold opacity-60 text-sm flex items-center gap-1 dark:text-gray-300"><Icon name="Wallet" size={14}/> {t('assets')}</h3><button onClick={()=>{setAssetForm({id:null, name:'', currency:'HKD', balance:'', type:'cash'}); setAssetModalOpen(true)}} className="text-[10px] bg-sakura-dark text-white px-2 py-1 rounded-full flex items-center gap-1 shadow-sm active:scale-95 transition-transform"><Icon name="Plus" size={10}/> {t('forge')}</button></div><div className="space-y-2">{data.accounts.map(acc => (<div key={acc.id} onClick={()=>{setAssetForm(acc); setAssetModalOpen(true)}} className="glass p-3 rounded-xl flex justify-between items-center active:scale-95 transition-transform cursor-pointer"><div className="flex items-center gap-3"><div className={`w-10 h-10 rounded-xl flex items-center justify-center text-white shadow-sm ${acc.type==='card'?'bg-purple-400':acc.type==='bank'?'bg-blue-400':'bg-yellow-400'}`}><Icon name={acc.type==='card'?'CreditCard':acc.type==='bank'?'Landmark':'Wallet'} size={20}/></div><div><div className="font-bold text-sm dark:text-white">{acc.name}</div><div className="text-[10px] opacity-60 uppercase dark:text-gray-400">{acc.type}</div></div></div><div className="text-right"><div className="font-mono font-bold dark:text-white">{acc.balance.toLocaleString()}</div><div className="text-[10px] opacity-60 font-bold bg-black/5 dark:bg-white/10 px-1 rounded inline-block dark:text-gray-300">{acc.currency}</div></div></div>))}</div></div>
                            </div>
                        )}
                        {/* Other views same as before, preserving structure */}
                        {view === 'exchange' && <div className="glass p-5 rounded-3xl guild-board"><div className="text-center font-bold mb-4 font-pixel tracking-widest border-b border-wood/30 pb-2 text-xl">公會佈告欄</div><div className="flex items-center gap-2 mb-4 bg-white/50 dark:bg-black/20 p-2 rounded-xl"><span className="font-bold text-sm ml-2">HKD</span><div onClick={()=>openKeypad('exchange', baseAmount)} className="flex-1 text-right font-mono font-bold text-xl mr-2 cursor-pointer dark:text-gray-800">{baseAmount}</div></div><div className="grid grid-cols-2 gap-3 pb-20">{CURRENCIES.filter(c=>c!=='HKD').map(c => (<div key={c} className="flex justify-between items-center text-sm border-b border-dashed border-black/10 dark:border-black/30 pb-1"><span className="font-bold opacity-70">{c}</span><span className="font-mono">{(parseFloat(baseAmount) * (rates[c]||0)).toLocaleString(undefined,{maximumFractionDigits:2})}</span></div>))}</div></div>}
                        {view === 'upgrade' && <div className="animate-[fadeIn_0.5s] space-y-4"><h2 className="text-xl font-bold flex items-center gap-2 mb-4 dark:text-white"><Icon name="Sword" size={20}/> 天賦強化</h2><div className="grid gap-3">{TALENTS.map((t,i) => (<div key={i} className="glass p-4 rounded-3xl flex items-center justify-between active:scale-95 transition-transform"><div className="flex items-center gap-4"><div className={`w-12 h-12 rounded-2xl flex items-center justify-center ${t.color}`}><Icon name={t.icon} size={24}/></div><div><h3 className="font-bold dark:text-white">{t.name}</h3><p className="text-xs opacity-60 dark:text-gray-300">{t.desc}</p></div></div><div className="font-bold text-sakura-dark">Lv.{t.lv}</div></div>))}</div></div>}
                        {view === 'quests' && <div className="animate-[fadeIn_0.5s] space-y-4"><div className="flex gap-2 mb-4 overflow-x-auto no-scrollbar">{['main','daily','challenge'].map(t => (<button key={t} onClick={()=>setSubView(t)} className={`px-5 py-2 rounded-full text-xs font-bold transition-colors active:scale-95 ${subView===t ? 'bg-sakura-dark text-white' : 'bg-white dark:bg-white/10 text-gray-500'}`}>{t==='main'?TRANSLATIONS[lang].main:t==='daily'?TRANSLATIONS[lang].daily:TRANSLATIONS[lang].challenge}</button>))}</div>{data.quests.filter(q => q.type === subView).map(q => (<div key={q.id} className="glass p-5 rounded-3xl relative active:scale-95 transition-transform"><div className="flex justify-between"><h4 className="font-bold text-ink dark:text-white">{q.title}</h4><span className="text-xs text-sakura-accent font-bold">EXP +{q.exp}</span></div><p className="text-xs opacity-60 mt-1 mb-3 dark:text-gray-300">{q.desc}</p><div className="flex items-center gap-2"><div className="flex-1 h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden"><div className="h-full bg-blue-400 transition-all" style={{width: `${Math.min(100, (q.progress/q.target)*100)}%`}}></div></div><span className="text-[10px] font-bold text-gray-400">{Math.min(q.progress,q.target)}/{q.target}</span></div></div>))}</div>}
                        {view === 'achievements' && <div className="grid grid-cols-2 gap-3 animate-[fadeIn_0.5s]">{data.achievements.map(a => (<div key={a.id} className={`glass p-4 rounded-3xl flex flex-col items-center text-center border-2 transition-all active:scale-95 ${a.unlocked ? 'border-yellow-400 bg-yellow-50/50 dark:bg-yellow-900/20' : 'border-gray-200 dark:border-gray-700 grayscale opacity-60'}`}><div className="w-14 h-14 bg-white dark:bg-gray-800 rounded-full flex items-center justify-center mb-2 shadow-sm text-yellow-500"><Icon name={a.unlocked ? a.icon : 'Key'} size={28}/></div><div className="font-bold text-sm dark:text-white">{a.title}</div><div className="text-[10px] opacity-60 mt-1 dark:text-gray-300">{a.desc}</div></div>))}</div>}
                        {view === 'journal' && <div className="animate-[fadeIn_0.5s] space-y-4"><div className="flex gap-2 mb-4"><button onClick={()=>setSubView('sys')} className={`flex-1 py-2 rounded-lg text-xs font-bold active:scale-95 transition-transform ${subView==='sys'?'bg-sakura-dark text-white':'bg-white dark:bg-white/10 dark:text-gray-400'}`}>系統事件</button><button onClick={()=>setSubView('fin')} className={`flex-1 py-2 rounded-lg text-xs font-bold active:scale-95 transition-transform ${subView==='fin'?'bg-sakura-dark text-white':'bg-white dark:bg-white/10 dark:text-gray-400'}`}>財務變動</button></div><div className="space-y-3">{data.logs.filter(l => subView==='sys' ? l.type==='system' : (l.type==='finance_out' || l.type==='finance_in')).map(l => (<div key={l.id} className="glass p-4 rounded-3xl flex gap-3 items-center active:scale-95 transition-transform"><div className={`w-2 h-10 rounded-full ${l.type==='system'?'bg-blue-400':l.type.includes('in')?'bg-green-400':'bg-red-400'}`}></div><div className="flex-1"><div className="text-[10px] opacity-60 dark:text-gray-400">{new Date(l.date).toLocaleString()}</div><div className="text-sm font-bold dark:text-white">{l.msg}</div></div></div>))}</div></div>}

                    </nav>

                    {keypadOpen && <Keypad value={tempValue} onChange={setTempValue} onConfirm={confirmKeypad} onClose={()=>setKeypadOpen(false)} label={t('calculator')} />}
                    
                    {catManagerOpen && <CategoryManager categories={data.categories} onSave={(newCats)=>{const newData={...data, categories:newCats}; saveData(newData);}} onClose={()=>setCatManagerOpen(false)} />}

                    {assetModalOpen && (
                        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex flex-col justify-center px-6 animate-[fadeIn_0.2s]">
                            <div className="bg-white dark:bg-dark-card rounded-3xl p-6 shadow-2xl animate-[slideUp_0.2s]">
                                <div className="flex justify-between mb-4"><h3 className="font-bold text-lg dark:text-white">{assetForm.id ? 'Edit' : t('forge')}</h3><button onClick={()=>setAssetModalOpen(false)} className="dark:text-white"><Icon name="X"/></button></div>
                                <div className="space-y-4">
                                    <input type="text" value={assetForm.name} onChange={e=>setAssetForm({...assetForm, name:e.target.value})} className="w-full bg-gray-100 dark:bg-black/30 p-4 rounded-2xl outline-none font-bold dark:text-white" placeholder="Name"/>
                                    <div className="flex gap-2">
                                        <select value={assetForm.currency} onChange={e=>setAssetForm({...assetForm, currency:e.target.value})} className="bg-gray-100 dark:bg-black/30 p-4 rounded-2xl font-bold w-1/3 dark:text-white">{CURRENCIES.map(c=><option key={c} value={c}>{c}</option>)}</select>
                                        <div onClick={()=>openKeypad('asset', assetForm.balance)} className="bg-gray-100 dark:bg-black/30 p-4 rounded-2xl font-bold w-2/3 cursor-pointer dark:text-white">{assetForm.balance || 'Balance'}</div>
                                    </div>
                                    <div className="grid grid-cols-3 gap-2">{['cash','bank','card'].map(type => (<button key={type} onClick={()=>setAssetForm({...assetForm, type})} className={`p-3 rounded-2xl border-2 flex flex-col items-center active:scale-95 transition-transform ${assetForm.type===type ? 'border-sakura-base bg-sakura-light/50 text-sakura-dark' : 'border-transparent bg-gray-100 dark:bg-black/30 dark:text-gray-400'}`}><Icon name={type==='card'?'CreditCard':type==='bank'?'Landmark':'Wallet'} size={20}/><span className="text-[10px] uppercase mt-1">{type}</span></button>))}</div>
                                    <button onClick={saveAsset} className="w-full py-4 bg-sakura-dark text-white rounded-2xl font-bold shadow-md active:scale-95 transition-transform">{t('save')}</button>
                                    {assetForm.id && <button onClick={deleteAsset} className="w-full py-3 text-red-400 font-bold active:scale-95 transition-transform">{t('delete')}</button>}
                                </div>
                            </div>
                        </div>
                    )}

                    {view === 'adventure' && (
                        <button onClick={()=>setModalOpen(true)} className="fixed bottom-24 right-4 w-16 h-16 bg-sakura-dark text-white rounded-full shadow-2xl flex items-center justify-center z-40 active:scale-95 transition-transform border-4 border-white dark:border-gray-800"><Icon name="Plus" size={32}/></button>
                    )}

                    {modalOpen && (
                        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex flex-col justify-end">
                            <div className="bg-white dark:bg-dark-card rounded-t-[2.5rem] p-6 animate-[slideUp_0.3s]">
                                <div className="flex justify-between items-center mb-6"><h3 className="font-bold text-lg dark:text-white">紀錄行動</h3><button onClick={()=>setModalOpen(false)} className="dark:text-white"><Icon name="X" size={20}/></button></div>
                                <div className="flex bg-gray-100 dark:bg-black/30 rounded-2xl p-1.5 mb-6"><button onClick={()=>setTxForm({...txForm, type:'expense'})} className={`flex-1 py-3 rounded-xl text-sm font-bold transition-all active:scale-95 ${txForm.type==='expense'?'bg-white dark:bg-gray-700 shadow dark:text-white':'dark:text-gray-400'}`}>支出</button><button onClick={()=>setTxForm({...txForm, type:'income'})} className={`flex-1 py-3 rounded-xl text-sm font-bold transition-all active:scale-95 ${txForm.type==='income'?'bg-white dark:bg-gray-700 shadow dark:text-white':'dark:text-gray-400'}`}>收入</button></div>
                                <div onClick={()=>openKeypad('tx', txForm.amount)} className="w-full text-5xl font-mono font-bold text-center border-b py-4 mb-6 cursor-pointer dark:text-white border-gray-200 dark:border-gray-700">{txForm.amount || '0'}</div>
                                {txForm.type === 'expense' && (
                                    <div className="relative mb-6">
                                        <div className="flex overflow-x-auto gap-3 pb-2 no-scrollbar pr-12">
                                            {data.categories.map((c) => (
                                                <button key={c.id} onClick={()=>setTxForm({...txForm, category: c.id})} className={`flex flex-col items-center flex-shrink-0 min-w-[60px] active:scale-95 transition-transform ${txForm.category === c.id ? 'opacity-100 scale-105' : 'opacity-50'}`}>
                                                    <div className="w-12 h-12 rounded-2xl flex items-center justify-center mb-1" style={{backgroundColor: c.color}}><Icon name={c.icon} size={20} color="white"/></div>
                                                    <span className="text-[9px] font-bold dark:text-gray-300">{c.label}</span>
                                                </button>
                                            ))}
                                        </div>
                                        <button onClick={()=>setCatManagerOpen(true)} className="absolute right-0 top-0 h-12 w-10 bg-white/80 dark:bg-black/50 backdrop-blur-sm flex items-center justify-center rounded-l-xl border-l dark:border-white/10"><Icon name="Settings" size={16}/></button>
                                    </div>
                                )}
                                <select onChange={e=>setTxForm({...txForm, accountId: e.target.value})} className="w-full bg-gray-50 dark:bg-black/30 p-4 rounded-2xl mb-6 outline-none font-bold dark:text-white"><option value="">選擇帳戶</option>{data.accounts.map(a=><option key={a.id} value={a.id}>{a.name}</option>)}</select>
                                <button onClick={addTransaction} className="w-full py-4 bg-sakura-dark text-white rounded-2xl font-bold shadow-lg text-lg active:scale-95 transition-transform">確認</button>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
