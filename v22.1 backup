        .btn-action { background-color: var(--accent-color); color: white; border: 2px solid var(--text-main); }
        
        /* Mobile Optimized Drag */
        .draggable-item { touch-action: pan-y; transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s, background-color 0.2s; }
