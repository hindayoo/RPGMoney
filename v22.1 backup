            const [modalOpen, setModalOpen] = useState(false);
            const [assetModalOpen, setAssetModalOpen] = useState(false);
            const [catManagerOpen, setCatManagerOpen] = useState(false);
            const [keypadOpen, setKeypadOpen] = useState(false);
            const [keypadTarget, setKeypadTarget] = useState(null); 
            const [tempValue, setTempValue] = useState('');
            const [txForm, setTxForm] = useState({ amount: '', note: '', type: 'expense', category: 'bf', accountId: '' });
            const [assetForm, setAssetForm] = useState({ id: null, name: '', currency: 'HKD', balance: '', type: 'cash' });
            
            const [flowView, setFlowView] = useState('today'); 
            const [logFilter, setLogFilter] = useState('all'); 
            const [showLevelUp, setShowLevelUp] = useState({ show: false, level: 1 });
            const [accountDragIndex, setAccountDragIndex] = useState(null);

            const [showThemeSelect, setShowThemeSelect] = useState(false);
            const [showCurrencySelect, setShowCurrencySelect] = useState(false);
            const [showTitleSelect, setShowTitleSelect] = useState(false);
            
            const [showNameEdit, setShowNameEdit] = useState(false);
            const [tempName, setTempName] = useState('');

            const [isRegistering, setIsRegistering] = useState(false);
            const [loginAccount, setLoginAccount] = useState('');
            const [loginPass, setLoginPass] = useState('');
            const [regName, setRegName] = useState('');
            const [showPass, setShowPass] = useState(false);

            const [theme, setTheme] = useState(localStorage.getItem('gw_theme') || 'ink');
            const [lang, setLang] = useState(localStorage.getItem('gw_lang') || 'zh');
            const [rates, setRates] = useState({});
            const [mainCurrency, setMainCurrency] = useState(localStorage.getItem('gw_currency') || 'TWD');
            const [baseAmount, setBaseAmount] = useState('100');
            const [calcBase, setCalcBase] = useState('TWD');

            const t = (key) => TRANSLATIONS[lang][key] || key;

            useEffect(() => {
                document.body.setAttribute('data-theme', theme);
                localStorage.setItem('gw_theme', theme);
            }, [theme]);
            
            useEffect(() => { localStorage.setItem('gw_lang', lang); }, [lang]);
            useEffect(() => { localStorage.setItem('gw_currency', mainCurrency); }, [mainCurrency]);

            const formatLogMsg = (log) => {
                const parts = log.msg.split(' ');
                if (parts[0] === 'Out' || parts[0] === 'In') {
                    const type = parts[0] === 'Out' ? 'log_expense' : 'log_income';
                    return `${t(type)} ${log.msg.substring(log.msg.indexOf(' ') + 1)}`;
                }
                if (log.msg.includes('Quest Claimed')) return `${t('log_sys_quest')}: ${log.msg.split(': ')[1]}`;
                if (log.msg.includes('Title Unlocked')) return `${t('log_sys_title')}: ${log.msg.split(': ')[1]}`;
                return log.msg;
            };

            const addLog = (type, msg) => { const newLog = { id: Date.now(), date: new Date().toISOString(), type, msg }; return [newLog, ...(data.logs || [])].slice(0, 50); };
            const saveData = (newData) => { setData(newData); const fb = window.firebase; if (fb && fb.auth && fb.auth.currentUser) fb.setDoc(fb.doc(fb.db, "users", fb.auth.currentUser.uid), newData).catch(console.error); else localStorage.setItem('gw_v20_2_data', JSON.stringify(newData)); };
            const loadLocalData = () => { 
                const localData = JSON.parse(localStorage.getItem('gw_v20_2_data')); 
                if (localData) { 
                    if (!localData.categories) localData.categories = DEFAULT_CATEGORIES;
                    if (!localData.talents) localData.talents = {};
                    if (!localData.claimedQuests) localData.claimedQuests = [];
                    if (!localData.user.unlockedTitles) localData.user.unlockedTitles = ['Novice'];
                    setData(localData); 
                } else {
                    setData(prev => ({ ...prev, user: null }));
                } 
                setLoading(false); 
            };
            const updateCategories = (newCats) => { saveData({ ...data, categories: newCats }); };

            useEffect(() => { 
                const t = setTimeout(() => { if (loading) loadLocalData(); }, 4000); 
                const fb = window.firebase; 
                if (!fb || !fb.auth) { loadLocalData(); return; } 
                const unsub = fb.onAuthStateChanged(fb.auth, (u) => { 
                    clearTimeout(t); 
                    if (u) { 
                        fb.onSnapshot(fb.doc(fb.db, "users", u.uid), (d) => { 
                            if (d.exists()) { 
                                let fd = d.data(); 
                                if(!fd.categories) fd.categories = DEFAULT_CATEGORIES; 
                                if(!fd.talents) fd.talents = {}; 
                                if(!fd.claimedQuests) fd.claimedQuests = []; 
                                if(!fd.user.unlockedTitles) fd.user.unlockedTitles = ['Novice']; 
                                setData(fd); 
                            } else { 
                                const init = { user: { uid: u.uid, name: u.displayName || 'Hero', level: 1, exp: 0, title: 'Novice', unlockedTitles: ['Novice'] }, accounts: [{ id: Date.now(), name: 'Wallet', currency: 'TWD', balance: 0, type: 'cash' }], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES, talents: {}, claimedQuests: [] }; 
                                fb.setDoc(fb.doc(fb.db, "users", u.uid), init); 
                                setData(init); 
                            } 
                            setLoading(false); 
                        }, () => loadLocalData()); 
                    } else { loadLocalData(); } 
                }); 
                return () => { unsub(); clearTimeout(t); } 
            }, []);
            
            useEffect(() => { fetch('https://open.er-api.com/v6/latest/TWD').then(r=>r.json()).then(d=>setRates(d.rates)).catch(console.error); }, []);
            useEffect(() => { if (!loading) document.getElementById('loading-screen').style.display = 'none'; document.getElementById('root').classList.remove('hidden'); }, [loading]);

            const checkUnlockables = (currentData) => {
                const rate = rates[mainCurrency] || 1; 
                const stats = {
                    totalExp: currentData.transactions.filter(t => t.type === 'expense').reduce((a,c) => a + (c.amount * (c.currency===mainCurrency ? 1 : 1)), 0),
                    balance: currentData.accounts.reduce((a,c) => a + (c.balance * (c.currency===mainCurrency ? 1 : 1)), 0),
                    txCount: currentData.transactions.length,
                    questCount: currentData.claimedQuests.length,
                    level: currentData.user.level
                };
                
                let newTitles = [...(currentData.user.unlockedTitles || ['Novice'])];
                let updated = false;
                TITLES_LIST.forEach(t => {
                    if (!newTitles.includes(t.id) && t.check(stats, 1)) {
                        newTitles.push(t.id);
                        updated = true;
                        addLog('system', `Title Unlocked: ${t.name}`);
                    }
                });
                if (updated) saveData({ ...currentData, user: { ...currentData.user, unlockedTitles: newTitles }, logs: [...addLog('system', 'New Titles Unlocked!'), ...(currentData.logs||[])] });
            };

            const convertMoney = (amountInTWD) => {
                const rate = rates[mainCurrency] || 1;
                return Math.floor(amountInTWD * rate);
            };

            const upgradeTalent = (tid) => {
                const currentLv = data.talents[tid] || 0;
                const newTalents = { ...data.talents, [tid]: currentLv + 1 };
                saveData({ ...data, talents: newTalents });
            };

            const handleClaim = (quest) => {
                let newExp = data.user.exp + quest.exp; 
                let newLv = data.user.level; 
                let leveledUp = false;

                if (newExp >= newLv * 100) { 
                    newLv++; 
                    newExp -= (newLv-1)*100; 
                    leveledUp = true;
                }
                
                const newClaimed = [...data.claimedQuests, quest.uniqueId];
                const newLogs = addLog('system', `Quest Claimed: ${quest.title}`);
                
                const newData = { ...data, user: { ...data.user, exp: newExp, level: newLv }, claimedQuests: newClaimed, logs: newLogs };
                saveData(newData);
                checkUnlockables(newData);
                if (leveledUp) setShowLevelUp({ show: true, level: newLv });
            };

            const handleAccountTouchMove = (e, index) => {
                if(e.cancelable) e.preventDefault();
                const touch = e.touches[0];
                const target = document.elementFromPoint(touch.clientX, touch.clientY);
                if (!target) return;
                const row = target.closest('[data-acc-index]');
                if (!row) return;
                const targetIndex = parseInt(row.dataset.accIndex);
                if (targetIndex !== index && targetIndex >= 0 && targetIndex < data.accounts.length) {
                    const newAccs = [...data.accounts];
                    const item = newAccs[index];
                    newAccs.splice(index, 1);
                    newAccs.splice(targetIndex, 0, item);
                    saveData({ ...data, accounts: newAccs }); 
                    setAccountDragIndex(targetIndex);
                }
            };

            const handleAuth = async () => { 
                const fb = window.firebase; 
                if (!fb || !fb.auth || !fb.app) {
                    const fakeUid = 'local_' + Date.now();
                    const newUser = { uid: fakeUid, name: regName || 'Adventurer', level: 1, exp: 0, title: 'Novice', unlockedTitles: ['Novice'], photo: '' };
                    const initData = { user: newUser, accounts: [{ id: 1, name: 'Wallet', currency: 'TWD', balance: 0, type: 'cash' }], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES, talents: {}, claimedQuests: [] };
                    localStorage.setItem('gw_v20_2_data', JSON.stringify(initData));
                    window.location.reload();
                    return;
                }
                const email = loginAccount.trim() + "@sakurarpg.com"; 
                try { 
                    if (isRegistering) { 
                        if (!/^[a-zA-Z0-9]+$/.test(loginAccount)) return alert(t('acc_alert')); 
                        const cred = await fb.createUserWithEmailAndPassword(fb.auth, email, loginPass); 
                        await fb.updateProfile(cred.user, { displayName: regName }); 
                        window.location.reload(); 
                    } else {
                        await fb.signInWithEmailAndPassword(fb.auth, email, loginPass); 
                    }
                } catch (e) { alert(e.message); } 
            };
            const logout = () => { const fb = window.firebase; if(fb && fb.auth) fb.signOut(fb.auth); localStorage.clear(); window.location.reload(); };
            const handleAvatarUpload = async (e) => { const file = e.target.files[0]; if(file){ const b64 = await resizeImage(file); saveData({...data, user: {...data.user, photo: b64}}); } };
            const openKeypad = (target, initVal) => { setKeypadTarget(target); setTempValue(initVal ? initVal.toString() : ''); setKeypadOpen(true); };
            const confirmKeypad = () => {
                const val = tempValue || '0';
                let finalVal = val;
                try { if (/^[0-9+\-*/.]+$/.test(val)) finalVal = eval(val).toString(); } catch {}
                if (keypadTarget === 'tx') setTxForm(prev => ({ ...prev, amount: finalVal }));
                else if (keypadTarget === 'asset') setAssetForm(prev => ({ ...prev, balance: finalVal }));
                else if (keypadTarget === 'exchange') setBaseAmount(finalVal);
                setKeypadOpen(false);
            };
            
            const handleRename = () => {
                if(!tempName.trim()) return;
                saveData({...data, user: {...data.user, name: tempName}});
                setShowNameEdit(false);
            };

            const addTransaction = () => {
                if(!txForm.amount || !txForm.accountId) return alert(t('missing_info'));
                const amt = parseFloat(txForm.amount);
                const acc = data.accounts.find(a => a.id == txForm.accountId);
                const newTx = { id: Date.now(), date: new Date().toISOString(), ...txForm, amount: amt, accountName: acc.name, currency: acc.currency };
                const newAccs = data.accounts.map(a => a.id == acc.id ? { ...a, balance: txForm.type === 'expense' ? a.balance - amt : a.balance + amt } : a);
                
                let newExp = data.user.exp + 5; 
                let newLv = data.user.level; 
                let leveledUp = false;
                if (newExp >= newLv * 100) { newLv++; newExp -= (newLv-1)*100; leveledUp = true; }

                const currentCat = data.categories[txForm.category] || DEFAULT_CATEGORIES.other;
                const newLogs = addLog(txForm.type==='expense'?'finance_out':'finance_in', `${txForm.type==='expense'?'Out':'In'} ${amt} (${currentCat.label}) ${txForm.note ? '- '+txForm.note : ''}`);
                
                const newData = { ...data, user: {...data.user, exp: newExp, level: newLv}, accounts: newAccs, transactions: [newTx, ...data.transactions], logs: newLogs };
                saveData(newData);
                checkUnlockables(newData);
                setModalOpen(false);
                if (leveledUp) setShowLevelUp({ show: true, level: newLv });
            };
            const saveAsset = () => {
                if (!assetForm.name || assetForm.balance === '') return alert(t('missing_info'));
                let newAccs = [...data.accounts];
                if (assetForm.id) newAccs = newAccs.map(a => a.id === assetForm.id ? { ...assetForm, balance: parseFloat(assetForm.balance) } : a);
                else newAccs.push({ ...assetForm, id: Date.now(), balance: parseFloat(assetForm.balance) });
                saveData({ ...data, accounts: newAccs });
                setAssetModalOpen(false);
            };
            const deleteAsset = () => { if (confirm(t('confirmDelete'))) { const newAccs = data.accounts.filter(a => a.id !== assetForm.id); saveData({ ...data, accounts: newAccs }); setAssetModalOpen(false); } };
            const guardian = useMemo(() => { if (!data.user) return GUARDIAN_STAGES[0]; return GUARDIAN_STAGES.findLast(s => data.user.level >= s.level) || GUARDIAN_STAGES[0]; }, [data.user]);

            // Quests Logic (Fixed: Strict Currency Filter)
            const activeQuests = useMemo(() => {
                const todayStr = new Date().toDateString();
                const relevantTxs = data.transactions.filter(t => t.currency === mainCurrency);
                const relevantAccs = data.accounts.filter(a => a.currency === mainCurrency);
                
                const totalExp = relevantTxs.filter(t => t.type === 'expense' && new Date(t.date).toDateString() === todayStr).reduce((a,c)=>a+c.amount, 0);
                const totalTxCount = data.transactions.length; 
                const dailyTxCount = data.transactions.filter(t => new Date(t.date).toDateString() === todayStr).length;
                
                const totalAssetVal = relevantAccs.reduce((a,c)=>a+c.balance, 0);
                const totalExpenseVal = relevantTxs.filter(t=>t.type==='expense').reduce((a,c)=>a+c.amount, 0);

                // Base values in TWD
                const rawQuests = [
                    { id: 'm1', type: 'main', title: '初次記帳', desc: '記錄第一筆消費', exp: 50, progress: totalTxCount > 0 ? 1 : 0, target: 1 },
                    { id: 'm2', type: 'main', title: '財務起步', desc: `累積消費 ${convertMoney(500)}`, exp: 100, progress: totalExpenseVal, target: convertMoney(500) },
                    { id: `d1_${todayStr}`, type: 'daily', title: '節儉美德', desc: `今日消費 < ${convertMoney(500)}`, exp: 20, progress: totalExp < convertMoney(500) ? 1 : 0, target: 1 },
                    { id: `d2_${todayStr}`, type: 'daily', title: '大額消費', desc: `單筆消費 > ${convertMoney(1000)}`, exp: 30, progress: relevantTxs.some(t => t.type === 'expense' && t.amount > convertMoney(1000) && new Date(t.date).toDateString() === todayStr) ? 1 : 0, target: 1 },
                    { id: `d3_${todayStr}`, type: 'daily', title: '記帳達人', desc: '今日記帳 3 次', exp: 40, progress: dailyTxCount, target: 3 },
                    { id: 'c1', type: 'challenge', title: '儲蓄大師', desc: `總資產 ${convertMoney(10000)}`, exp: 200, progress: totalAssetVal, target: convertMoney(10000) },
                    { id: 'c2', type: 'challenge', title: '消費狂人', desc: `累積消費 ${convertMoney(50000)}`, exp: 500, progress: totalExpenseVal, target: convertMoney(50000) },
                    { id: 'c3', type: 'challenge', title: '交易大師', desc: '累積 100 筆交易', exp: 300, progress: totalTxCount, target: 100 }
                ];
                return rawQuests.filter(q => q.type === subView).map(q => ({...q, uniqueId: q.id, isClaimed: data.claimedQuests.includes(q.id), isCompleted: q.progress >= q.target})).sort((a, b) => { if (a.isClaimed && !b.isClaimed) return 1; if (!a.isClaimed && b.isClaimed) return -1; if (a.isCompleted && !b.isCompleted) return -1; return 0; });
            }, [data, subView, mainCurrency, rates]);

            // Financial Summary Logic
            const financialStats = useMemo(() => {
                const now = new Date();
                const todayStr = now.toDateString();
                const currentMonth = now.getMonth();
                const currentYear = now.getFullYear();
                
                const todayTxs = data.transactions.filter(t => new Date(t.date).toDateString() === todayStr);
                const monthTxs = data.transactions.filter(t => { const d = new Date(t.date); return d.getMonth() === currentMonth && d.getFullYear() === currentYear; });

                const calc = (list) => {
                    return {
                        in: list.filter(t => t.type === 'income').reduce((a,c) => a + c.amount, 0),
                        out: list.filter(t => t.type === 'expense').reduce((a,c) => a + c.amount, 0)
                    };
                };

                return { tStats: calc(todayTxs), mStats: calc(monthTxs) };
            }, [data.transactions]);

            const filteredLogs = useMemo(() => {
                return data.logs.filter(l => {
                    if (subView === 'sys') return l.type === 'system';
                    if (subView === 'fin') {
                        if (l.type === 'system') return false; 
                        const logDate = new Date(l.date);
                        const now = new Date();
                        if (logFilter === 'today') return logDate.toDateString() === now.toDateString();
                        if (logFilter === 'month') return logDate.getMonth() === now.getMonth() && logDate.getFullYear() === now.getFullYear();
                        return true; 
                    }
                    return false;
                });
            }, [data.logs, subView, logFilter]);

            if (loading) return null;
            if (!data.user) return ( 
                <div className="h-[100dvh] flex flex-col items-center justify-center p-6 animate-[fadeIn_0.5s] overflow-y-auto relative">
                    <button onClick={() => setShowThemeSelect(true)} className="absolute top-6 right-6 p-2 rounded-full bg-theme-glass text-theme-accent shadow-sm border border-theme-border z-50"><Icon name="Paint"/></button>
                    <div className="text-6xl mb-6 animate-float">🛡️</div>
                    <h1 className="text-2xl font-bold text-theme-text mb-8 font-pixel tracking-widest text-center">{t('login_title')}</h1>
                    <div className="w-full max-w-sm glass p-8 rounded-[2.5rem] shadow-2xl flex flex-col gap-5 border-4 border-theme-border">
                        <div className="flex bg-theme-bg rounded-full p-1">
                            <button onClick={()=>setIsRegistering(false)} className={`flex-1 py-2 rounded-full text-xs font-bold transition-all ${!isRegistering ? 'bg-theme-accent text-white shadow' : 'text-theme-sub'}`}>{t('login_btn')}</button>
                            <button onClick={()=>setIsRegistering(true)} className={`flex-1 py-2 rounded-full text-xs font-bold transition-all ${isRegistering ? 'bg-theme-accent text-white shadow' : 'text-theme-sub'}`}>{t('register_btn')}</button>
                        </div>
                        {isRegistering && <input type="text" placeholder={t('nick_placeholder')} value={regName} onChange={e=>setRegName(e.target.value)} className="rpg-input"/>}
                        <input type="text" placeholder={t('id_placeholder')} value={loginAccount} onChange={e=>setLoginAccount(e.target.value)} className="rpg-input"/>
                        <div className="relative mt-1">
                            <input type={showPass ? "text" : "password"} value={loginPass} onChange={e=>setLoginPass(e.target.value)} className="rpg-input" placeholder={t('pass_placeholder')}/>
                            <button onClick={()=>setShowPass(!showPass)} className="absolute right-4 top-4 opacity-50 text-theme-text"><Icon name={showPass?'EyeOff':'Eye'} size={20}/></button>
                        </div>
                        <button onClick={handleAuth} className="w-full py-4 bg-theme-accent text-white rounded-2xl font-bold shadow-lg active:scale-95 transition-transform text-lg mt-2">{isRegistering ? t('register_title') : t('login_btn')}</button>
                        <div className="text-center mt-2"><p className="text-xs text-gray-400 cursor-pointer hover:text-sakura-dark" onClick={()=>setIsRegistering(!isRegistering)}>{isRegistering ? t('have_acc') : t('new_user')}</p>{isRegistering && <p className="text-[10px] text-red-300 mt-1">*{t('name_alert')}</p>}</div>
                    </div>
                    <button onClick={() => saveData({ user: { uid: 'guest', name: regName || 'Guest', level: 1, exp: 0, title: 'Novice', unlockedTitles: ['Novice'], photo: '' }, accounts: [{ id: 1, name: 'Wallet', currency: 'TWD', balance: 0, type: 'cash' }], transactions: [], quests: [], achievements: [], logs: [], categories: DEFAULT_CATEGORIES, talents: {}, claimedQuests: [] })} className="mt-8 text-xs text-theme-sub underline">{t('guest')}</button>
                    {showThemeSelect && <SelectorSheet title="選擇外觀風格" options={THEMES.map(t => ({ value: t.id, label: t.name, color: t.color }))} current={theme} onSelect={setTheme} onClose={() => setShowThemeSelect(false)} />}
                </div> 
            );

            return (
                <div className="flex flex-col h-[100dvh] relative z-10 text-theme-text overflow-hidden">
                    <BackgroundIllustrations theme={theme} />
                    <header className="px-4 pt-12 pb-2 flex flex-col gap-2 bg-theme-glass sticky top-0 z-20 backdrop-blur-md border-b border-theme-border shrink-0">
                        <div className="flex justify-between items-center w-full">
                            <div className="flex items-center gap-3">
                                <label className="relative cursor-pointer avatar-glow"><div className="w-11 h-11 rounded-full bg-theme-card border-2 border-theme-accent overflow-hidden shadow-md flex items-center justify-center text-xl">{data.user.photo ? <img src={data.user.photo} className="w-full h-full object-cover"/> : "👤"}</div><input type="file" accept="image/*" onChange={handleAvatarUpload} className="hidden"/></label>
                                <div><div className="flex items-center gap-2"><h1 onClick={()=>{setTempName(data.user.name); setShowNameEdit(true);}} className="font-bold text-sm text-theme-text cursor-pointer hover:underline flex items-center gap-1">{data.user.name} <Icon name="Edit" size={12}/></h1><span className="text-[9px] bg-theme-accent text-white px-1.5 rounded-full">Lv.{data.user.level}</span></div><div onClick={()=>setShowTitleSelect(true)} className="text-[10px] text-theme-accent font-bold opacity-80 cursor-pointer hover:underline">{data.user.title} <Icon name="Edit" size={10} className="inline"/></div></div>
                            </div>
                            <div className="flex gap-2">
                                <button onClick={() => setShowCurrencySelect(true)} className="w-9 h-9 bg-theme-bg text-theme-text rounded-full flex items-center justify-center shadow-sm border border-theme-border text-[9px] font-bold active:scale-95 transition-transform">{mainCurrency}</button>
                                <button onClick={()=>setLang(l=>l==='zh'?'en':l==='en'?'ja':'zh')} className="w-9 h-9 bg-theme-bg text-theme-text rounded-full flex items-center justify-center shadow-sm border border-theme-border text-[10px] font-bold active:scale-95 transition-transform">{lang.toUpperCase()}</button>
                                <button onClick={() => setShowThemeSelect(true)} className="w-9 h-9 bg-theme-bg text-theme-accent rounded-full flex items-center justify-center shadow-sm border border-theme-border active:scale-95 transition-transform"><Icon name="Paint" size={16}/></button>
                                <button onClick={logout} className="w-9 h-9 bg-red-100/50 text-red-500 rounded-full flex items-center justify-center shadow-sm border border-theme-border active:scale-95 transition-transform"><Icon name="LogOut" size={16}/></button>
                            </div>
                        </div>
                        <div className="w-full mt-1 relative">
                            <div className="flex justify-between text-[10px] font-bold opacity-60 mb-1 text-theme-sub"><span>NEXT LEVEL</span><span>{data.user.exp} / {data.user.level * 100}</span></div>
                            <div className="w-full h-2 bg-theme-bg rounded-full overflow-hidden shadow-inner border border-theme-border"><div className="h-full bg-theme-accent transition-all duration-700" style={{width: `${(data.user.exp / (data.user.level*100))*100}%`}}></div></div>
                        </div>
                    </header>

                    <main className="flex-1 overflow-y-auto no-scrollbar pb-24 p-4 space-y-5 relative z-10">
                        {view === 'adventure' && (
                            <div className="animate-[fadeIn_0.5s] space-y-5">
                                <div className="glass p-6 rounded-[2.5rem] relative text-center border-theme-accent/50"><div className="text-8xl animate-float filter drop-shadow-xl mb-4 font-pixel">{guardian.emoji}</div><div className="bg-theme-bg rounded-xl p-3 border border-theme-border text-left mb-3"><div className="flex justify-between items-center mb-1"><h2 className="text-sm font-bold font-pixel text-theme-text">{guardian.name}</h2><span className="text-[9px] bg-theme-accent text-white px-1 rounded font-pixel">Lv.{data.user.level}</span></div><p className="text-[10px] opacity-70 font-pixel leading-tight text-theme-sub">{guardian.desc}</p></div><div className="flex items-center gap-2"><span className="text-[8px] font-bold text-theme-accent">EXP</span><div className="flex-1 h-3 bg-theme-bg rounded-full overflow-hidden relative"><div className="absolute inset-0 flex items-center justify-center text-[8px] text-theme-text font-bold z-10">{data.user.exp % 100} / 100</div><div className="h-full bg-theme-accent transition-all opacity-50" style={{width: `${(data.user.exp % 100)}%`}}></div></div></div></div>
                                <div>
                                    <div className="flex justify-between items-center mb-2"><h3 className="font-bold opacity-60 text-sm flex items-center gap-1 text-theme-text"><Icon name="Wallet" size={14}/> {t('assets')}</h3><button onClick={()=>{setAssetForm({id:null, name:'', currency:mainCurrency, balance:'', type:'cash'}); setAssetModalOpen(true)}} className="text-[10px] bg-theme-accent text-white px-2 py-1 rounded-full flex items-center gap-1 shadow-sm active:scale-95 transition-transform"><Icon name="Plus" size={10}/> {t('forge')}</button></div>
                                    <div className="space-y-2">
                                        {data.accounts.map((acc, index) => (
                                            <div key={acc.id} data-acc-index={index} onClick={()=>{setAssetForm(acc); setAssetModalOpen(true)}} className={`glass p-4 rounded-xl flex justify-between items-center active:scale-95 transition-transform cursor-pointer border-l-4 border-theme-accent draggable-item ${accountDragIndex === index ? 'dragging-active' : ''}`}>
                                                <div className="flex items-center gap-3">
                                                    <div 
                                                        className="text-theme-sub drag-handle p-2 -ml-2 touch-none" 
                                                        onTouchStart={() => setAccountDragIndex(index)}
                                                        onTouchMove={(e) => handleAccountTouchMove(e, accountDragIndex)}
                                                        onTouchEnd={() => setAccountDragIndex(null)}
                                                        onMouseDown={() => setAccountDragIndex(index)}
                                                        onClick={(e)=>e.stopPropagation()}
                                                    >
                                                        <Icon name="Grip" size={20}/>
                                                    </div>
                                                    <div><div className="font-bold text-sm text-theme-text">{acc.name}</div><div className="text-[10px] opacity-60 uppercase text-theme-sub">{acc.type}</div></div>
                                                </div>
                                                <div className="text-right"><div className="font-mono font-bold text-theme-text text-lg">{acc.balance.toLocaleString()}</div><div className="text-[10px] opacity-60 font-bold text-theme-sub">{acc.currency}</div></div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        )}

                        {view === 'upgrade' && <CharacterTab talents={data.talents} onUpgrade={upgradeTalent} />}
                        
                        {view === 'quests' && ( 
                            <div className="animate-[fadeIn_0.5s] space-y-4">
                                <div className="flex gap-2 mb-4 overflow-x-auto no-scrollbar">{['main','daily','challenge'].map(t => (<button key={t} onClick={()=>setSubView(t)} className={`px-5 py-2 rounded-full text-xs font-bold transition-colors active:scale-95 ${subView===t ? 'bg-theme-accent text-white' : 'bg-theme-bg text-theme-sub'}`}>{TRANSLATIONS[lang][t] || t}</button>))}</div>
                                {activeQuests.map(q => (
                                    <div key={q.id} className={`glass p-5 rounded-3xl relative active:scale-95 transition-transform ${q.isClaimed ? 'opacity-50 grayscale' : ''}`}>
                                        <div className="flex justify-between"><h4 className="font-bold text-theme-text">{q.title}</h4><div className="flex gap-2"><span className="text-xs text-theme-accent font-bold">EXP +{q.exp}</span></div></div>
                                        <p className="text-xs opacity-60 mt-1 mb-3 text-theme-sub">{q.desc}</p>
                                        <div className="flex items-center gap-2 mb-2"><div className="flex-1 h-3 bg-theme-bg rounded-full overflow-hidden"><div className="h-full bg-theme-accent transition-all" style={{width: `${Math.min(100, (q.progress/q.target)*100)}%`}}></div></div><span className="text-[10px] font-bold text-theme-sub">{Math.floor(q.progress)}/{q.target}</span></div>
                                        {q.isCompleted && !q.isClaimed && <button onClick={()=>handleClaim(q)} className="w-full py-2 btn-claim rounded-xl font-bold text-xs">{t('claim')}</button>}
                                        {q.isClaimed && <div className="text-center text-[10px] font-bold text-theme-sub border-t border-theme-border pt-2 mt-2">{t('claimed')}</div>}
                                    </div>
                                ))}
                            </div> 
                        )}
                        
                        {view === 'achievements' && ( <div className="grid gap-3 animate-[fadeIn_0.5s]">{data.achievements.map(a => (<div key={a.id} className={`achievement-card ${a.unlocked ? 'unlocked' : 'locked'}`}><div className="w-12 h-12 rounded-full flex items-center justify-center bg-theme-bg text-theme-accent shrink-0 border border-theme-border shadow-sm"><Icon name={a.unlocked ? a.icon : 'Lock'} size={24}/></div><div className="flex-1"><div className="font-bold text-sm text-theme-text">{a.title}</div><div className="text-[10px] opacity-70 text-theme-sub">{a.desc}</div>{a.target && (<div className="mt-2 flex items-center gap-2"><div className="flex-1 h-1.5 bg-theme-bg rounded-full overflow-hidden border border-theme-border/50"><div className="h-full bg-theme-accent" style={{width: `${Math.min(100, (a.progress/a.target)*100)}%`}}></div></div><span className="text-[8px] font-bold text-theme-sub">{a.progress}/{a.target}</span></div>)}</div></div>))}</div> )}
                        
                        {view === 'exchange' && ( 
                            <div className="animate-[fadeIn_0.5s] space-y-4">
                                <div className="glass p-5 rounded-3xl border-4 border-wood bg-[#F5E6D3] text-[#5D4037]">
                                    <div className="text-center font-bold mb-4 font-pixel tracking-widest border-b border-wood/30 pb-2 text-xl">公會佈告欄</div>
                                    <div className="flex items-center gap-2 mb-4 bg-white/50 p-2 rounded-xl">
                                        <select value={calcBase} onChange={e=>setCalcBase(e.target.value)} className="bg-transparent font-bold text-sm outline-none w-16 text-[#5D4037]">{EXCHANGE_CURRENCIES.map(c => <option key={c} value={c}>{c}</option>)}</select>
                                        <div onClick={()=>openKeypad('exchange', baseAmount)} className="flex-1 text-right font-mono font-bold text-xl mr-2 cursor-pointer">{baseAmount}</div>
                                    </div>
                                    <div className="flex flex-col gap-3 pb-20">
                                        {EXCHANGE_CURRENCIES.filter(c=>c!==calcBase).map(c => {
                                            const val = (parseFloat(baseAmount) / (rates[calcBase] || 1)) * (rates[c] || 1);
                                            return (
                                                <div key={c} className="glass p-4 rounded-xl flex justify-between items-center text-sm bg-white/40 shadow-sm">
                                                    <span className="font-bold opacity-70 text-lg">{c}</span>
                                                    <span className="font-mono text-xl font-bold">{val.toLocaleString(undefined,{maximumFractionDigits:2})}</span>
                                                </div>
                                            );
                                        })}
                                    </div>
                                </div>
                            </div> 
                        )}
                        
                        {view === 'journal' && ( 
                            <div className="animate-[fadeIn_0.5s] space-y-4">
                                {/* Mana Flow Dashboard (Switchable) */}
                                <div className="glass p-4 rounded-3xl border border-theme-border">
                                    <div className="flex justify-between items-center mb-3">
                                        <h3 className="font-bold text-sm text-theme-text flex items-center gap-2"><Icon name="Chart" size={16}/> 瑪娜流動</h3>
                                        <div className="flex bg-theme-bg rounded-lg p-0.5">
                                            <button onClick={()=>setFlowView('today')} className={`px-3 py-1 rounded-md text-[10px] font-bold transition-all ${flowView==='today'?'bg-theme-accent text-white shadow':'text-theme-sub'}`}>今日</button>
                                            <button onClick={()=>setFlowView('month')} className={`px-3 py-1 rounded-md text-[10px] font-bold transition-all ${flowView==='month'?'bg-theme-accent text-white shadow':'text-theme-sub'}`}>本月</button>
                                        </div>
                                    </div>
                                    
                                    <div className="flex gap-4">
                                        <div className="flex-1 bg-green-50/50 dark:bg-green-900/20 p-3 rounded-2xl border border-green-100 dark:border-green-800/30 flex flex-col items-center">
                                            <span className="text-[10px] text-green-600 font-bold mb-1">IN</span>
                                            <span className="text-xl font-mono font-bold text-green-500">+{flowView==='today' ? financialStats.tStats.in : financialStats.mStats.in}</span>
                                        </div>
                                        <div className="flex-1 bg-red-50/50 dark:bg-red-900/20 p-3 rounded-2xl border border-red-100 dark:border-red-800/30 flex flex-col items-center">
                                            <span className="text-[10px] text-red-600 font-bold mb-1">OUT</span>
                                            <span className="text-xl font-mono font-bold text-red-500">-{flowView==='today' ? financialStats.tStats.out : financialStats.mStats.out}</span>
                                        </div>
                                    </div>
                                </div>

                                <div className="flex gap-2 mb-2">
                                    <button onClick={()=>setSubView('fin')} className={`flex-1 py-2 rounded-lg text-xs font-bold active:scale-95 transition-transform ${subView==='fin'?'bg-theme-accent text-white':'bg-theme-bg text-theme-sub'}`}>財務變動</button>
                                    <button onClick={()=>setSubView('sys')} className={`flex-1 py-2 rounded-lg text-xs font-bold active:scale-95 transition-transform ${subView==='sys'?'bg-theme-accent text-white':'bg-theme-bg text-theme-sub'}`}>系統事件</button>
                                </div>

                                {subView === 'fin' && (
                                    <div className="flex gap-2 mb-2 overflow-x-auto no-scrollbar pb-1">
                                        {['all', 'month', 'today'].map(f => (
                                            <button key={f} onClick={()=>setLogFilter(f)} className={`px-4 py-1.5 rounded-full text-[10px] font-bold border transition-colors whitespace-nowrap ${logFilter===f ? 'bg-theme-accent text-white border-theme-accent' : 'bg-transparent text-theme-sub border-theme-border'}`}>
                                                {f==='all'?'全部':f==='month'?'本月':'今日'}
                                            </button>
                                        ))}
                                    </div>
                                )}

                                <div className="space-y-3 pb-20 min-h-[200px]">
                                    {filteredLogs.length > 0 ? (
                                        filteredLogs.map(l => (
                                            <div key={l.id} className="glass p-4 rounded-3xl flex gap-3 items-center active:scale-95 transition-transform">
                                                <div className={`w-2 h-10 rounded-full ${l.type==='system'?'bg-blue-400':l.type.includes('in')?'bg-green-400':'bg-red-400'}`}></div>
                                                <div className="flex-1">
                                                    <div className="text-[10px] opacity-60 text-theme-sub">{new Date(l.date).toLocaleString()}</div>
                                                    <div className="text-sm font-bold text-theme-text">{formatLogMsg(l)}</div>
                                                </div>
                                            </div>
                                        ))
                                    ) : (
                                        <div className="flex flex-col items-center justify-center py-10 opacity-50">
                                            <Icon name="Ghost" size={48} className="text-theme-sub mb-2"/>
                                            <span className="text-xs text-theme-sub font-bold">尚無相關紀錄</span>
                                        </div>
                                    )}
                                </div>
                            </div> 
                        )}
                    </main>

                    <nav className="fixed bottom-0 w-full glass border-t border-theme-border nav-safe px-2 flex justify-between items-center z-30 h-24 rounded-t-3xl shadow-[0_-10px_20px_rgba(0,0,0,0.05)] shrink-0">
                        {[ {id:'adventure', icon:'Home', l:t('adventure')}, {id:'quests', icon:'Scroll', l:t('quests')}, {id:'achievements', icon:'Trophy', l:t('achievements')}, {id:'upgrade', icon:'Sword', l:t('upgrade')}, {id:'exchange', icon:'Globe', l:t('exchange')}, {id:'journal', icon:'Book', l:t('journal')} ].map(b => (<button key={b.id} onClick={()=>setView(b.id)} className={`flex flex-col items-center gap-1 w-full transition-all active:scale-95 ${view===b.id ? 'text-theme-accent -translate-y-2' : 'opacity-40 text-theme-sub'}`}><Icon name={b.icon} size={22} strokeWidth={view===b.id?2.5:2}/><span className="text-[9px] font-bold">{b.l}</span></button>))}
                    </nav>

                    {keypadOpen && <Keypad value={tempValue} onChange={setTempValue} onConfirm={confirmKeypad} onClose={()=>setKeypadOpen(false)} label={t('calculator')} />}
                    {catManagerOpen && <CategoryManager categories={data.categories} onSave={updateCategories} onClose={()=>setCatManagerOpen(false)} />}
                    {showLevelUp.show && <LevelUpOverlay level={showLevelUp.level} onClose={()=>setShowLevelUp({show:false, level:showLevelUp.level})}/>}
                    
                    {/* Selectors Modals */}
                    {showThemeSelect && <SelectorSheet title="選擇外觀風格" options={THEMES.map(t => ({ value: t.id, label: t.name, color: t.color }))} current={theme} onSelect={setTheme} onClose={() => setShowThemeSelect(false)} />}
                    {showCurrencySelect && <SelectorSheet title="選擇主要貨幣" options={MAIN_CURRENCIES.map(c => ({ value: c, label: c }))} current={mainCurrency} onSelect={setMainCurrency} onClose={() => setShowCurrencySelect(false)} />}
                    {showTitleSelect && <SelectorSheet 
                        title={t('change_title')} 
                        options={TITLES_LIST.map(t => ({ value: t.id, label: t.name, locked: !data.user.unlockedTitles.includes(t.id), desc: t.desc, condition: t.condition }))} 
                        current={data.user.title} 
                        onSelect={(val) => { if(data.user.unlockedTitles.includes(val)) saveData({...data, user: {...data.user, title: val}}); }} 
                        onLockedClick={(t) => alert(`🔒 [${t.name}]\n\n📜 描述: ${t.desc}\n🔑 解鎖條件: ${t.condition}`)}
                        onClose={() => setShowTitleSelect(false)} 
                    />}
                    
                    {/* Rename Modal */}
                    {showNameEdit && (
                        <div className="fixed inset-0 z-[90] flex flex-col justify-center items-center bg-black/60 backdrop-blur-sm px-6 animate-[fadeIn_0.2s]">
                            <div className="bg-theme-card p-6 rounded-3xl w-full max-w-sm shadow-2xl animate-[slideUp_0.2s]">
                                <h3 className="font-bold text-lg text-theme-text mb-4 text-center">更換冒險者代號</h3>
                                <input type="text" value={tempName} onChange={e=>setTempName(e.target.value)} className="rpg-input mb-4" placeholder="輸入新名稱" autoFocus />
                                <div className="flex gap-3">
                                    <button onClick={() => setShowNameEdit(false)} className="flex-1 py-3 bg-theme-bg text-theme-sub rounded-xl font-bold">取消</button>
                                    <button onClick={handleRename} className="flex-1 py-3 bg-theme-accent text-white rounded-xl font-bold shadow-md">確認</button>
                                </div>
                            </div>
                        </div>
                    )}
                    
                    {assetModalOpen && (
                        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex flex-col justify-center px-6 animate-[fadeIn_0.2s]">
                            <div className="bg-theme-card rounded-3xl p-6 shadow-2xl animate-[slideUp_0.2s]">
                                <div className="flex justify-between mb-4"><h3 className="font-bold text-lg text-theme-text">{assetForm.id ? 'Edit' : t('forge_intro')}</h3><button onClick={()=>setAssetModalOpen(false)} className="text-theme-text"><Icon name="X"/></button></div>
                                <div className="space-y-4">
                                    <input type="text" value={assetForm.name} onChange={e=>setAssetForm({...assetForm, name:e.target.value})} className="w-full bg-theme-bg p-4 rounded-2xl outline-none font-bold text-theme-text" placeholder={t('acc_name')}/>
                                    <div className="flex gap-2">
                                        <select value={assetForm.currency} onChange={e=>setAssetForm({...assetForm, currency:e.target.value})} className="bg-theme-bg p-4 rounded-2xl font-bold w-1/3 text-theme-text">{MAIN_CURRENCIES.map(c=><option key={c} value={c}>{c}</option>)}</select>
                                        <div onClick={()=>openKeypad('asset', assetForm.balance)} className="bg-theme-bg p-4 rounded-2xl font-bold w-2/3 cursor-pointer text-theme-text">{assetForm.balance || t('acc_bal')}</div>
                                    </div>
                                    <div className="text-xs text-theme-sub font-bold">{t('acc_type')}</div>
                                    <div className="grid grid-cols-3 gap-2">{['cash','bank','card'].map(type => (<button key={type} onClick={()=>setAssetForm({...assetForm, type})} className={`p-3 rounded-2xl border-2 flex flex-col items-center active:scale-95 transition-transform ${assetForm.type===type ? 'border-theme-accent bg-theme-bg text-theme-accent' : 'border-transparent bg-theme-bg text-theme-sub'}`}><Icon name={type==='card'?'CreditCard':type==='bank'?'Landmark':'Wallet'} size={20}/><span className="text-[10px] uppercase mt-1">{type}</span></button>))}</div>
                                    <button onClick={saveAsset} className="w-full py-4 bg-theme-accent text-white rounded-2xl font-bold shadow-md active:scale-95 transition-transform">{t('save')}</button>
                                    {assetForm.id && <button onClick={deleteAsset} className="w-full py-3 text-red-400 font-bold active:scale-95 transition-transform">{t('delete')}</button>}
                                </div>
                            </div>
                        </div>
                    )}
                    
                    {view === 'adventure' && (
                        <button onClick={()=>{setTxForm({...txForm, note: ''}); setModalOpen(true)}} className="fixed bottom-24 right-4 w-16 h-16 bg-theme-accent text-white rounded-full shadow-2xl flex items-center justify-center z-40 active:scale-95 transition-transform border-4 border-theme-bg"><Icon name="Plus" size={32}/></button>
                    )}

                    {modalOpen && (
                        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex flex-col justify-end">
                            <div className="bg-theme-card rounded-t-[2.5rem] p-6 animate-[slideUp_0.3s]">
                                <div className="flex justify-between items-center mb-6"><h3 className="font-bold text-lg text-theme-text">紀錄行動</h3><button onClick={()=>setModalOpen(false)} className="text-theme-text"><Icon name="X" size={20}/></button></div>
                                <div className="flex bg-theme-bg rounded-2xl p-1.5 mb-6">
                                    <button onClick={()=>setTxForm({...txForm, type:'expense'})} className={`flex-1 py-3 rounded-xl text-sm font-bold transition-all active:scale-95 ${txForm.type==='expense'?'bg-theme-card shadow text-theme-text':'text-theme-sub'}`}>支出</button>
                                    <button onClick={()=>setTxForm({...txForm, type:'income'})} className={`flex-1 py-3 rounded-xl text-sm font-bold transition-all active:scale-95 ${txForm.type==='income'?'bg-theme-card shadow text-theme-text':'text-theme-sub'}`}>收入</button>
                                </div>
                                <div onClick={()=>openKeypad('tx', txForm.amount)} className="w-full text-5xl font-mono font-bold text-center border-b border-theme-border py-4 mb-6 cursor-pointer text-theme-text">{txForm.amount || '0'}</div>
                                {txForm.type === 'expense' && (
                                    <div className="mb-6">
                                        <div className="flex justify-between items-center mb-2 px-1">
                                            <span className="text-xs font-bold text-theme-sub">類別</span>
                                            <button onClick={()=>{ setModalOpen(false); setCatManagerOpen(true); }} className="text-xs text-theme-accent font-bold underline">管理類別</button>
                                        </div>
                                        <div className="grid grid-cols-5 gap-2 max-h-48 overflow-y-auto pr-1">
                                            {Object.entries(data.categories || DEFAULT_CATEGORIES).sort((a,b) => (a[1].order || 99) - (b[1].order || 99)).map(([k,c]) => (
                                                <button key={k} onClick={()=>setTxForm({...txForm, category: k})} className={`flex flex-col items-center p-2 rounded-xl transition-all active:scale-95 ${txForm.category === k ? 'bg-theme-glass scale-105 shadow-inner' : 'opacity-50'}`}>
                                                    <div className="w-8 h-8 rounded-full flex items-center justify-center transition-transform" style={{backgroundColor: c.color}}><Icon name={c.icon} size={14} color="white"/></div><span className="text-[9px] mt-1 font-bold text-theme-text truncate w-full text-center">{c.label}</span>
                                                </button>
                                            ))}
                                        </div>
                                    </div>
                                )}
                                <input type="text" value={txForm.note} onChange={e=>setTxForm({...txForm, note: e.target.value})} className="w-full bg-theme-bg p-4 rounded-2xl mb-4 outline-none font-bold text-theme-text placeholder-theme-sub" placeholder="備註 (選填)"/>
                                <select onChange={e=>setTxForm({...txForm, accountId: e.target.value})} className="w-full bg-theme-bg p-4 rounded-2xl mb-6 outline-none font-bold text-theme-text">
                                    <option value="">選擇帳戶</option>{data.accounts.map(a=><option key={a.id} value={a.id}>{a.name}</option>)}
                                </select>
                                <button onClick={addTransaction} className="w-full py-4 bg-theme-accent text-white rounded-2xl font-bold shadow-lg text-lg active:scale-95 transition-transform">確認</button>
                            </div>
                        </div>
                    )}
                </div>
            );
        };
        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
