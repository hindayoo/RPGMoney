            const handleTouchMove = (e, index) => {
                if(e.cancelable) e.preventDefault();
                const touch = e.touches[0];
                const target = document.elementFromPoint(touch.clientX, touch.clientY);
                if (!target) return;
                const row = target.closest('[data-index]');
                if (!row) return;
                const targetIndex = parseInt(row.dataset.index);
                if (targetIndex !== index && targetIndex >= 0 && targetIndex < localCats.length) {
                    const newList = [...localCats];
                    const item = newList[index];
                    newList.splice(index, 1);
                    newList.splice(targetIndex, 0, item);
                    setLocalCats(newList);
                    setDraggingIndex(targetIndex);
                }
            };

            const handleEdit = (key, cat) => { setEditId(key); setEditForm({ label: cat.label, color: cat.color, icon: cat.icon || 'Star' }); setIconPickerOpen(false); };
            const saveEdit = () => { if(!editForm.label) return; const newCats = localCats.map(([k, c]) => k === editId ? [k, { ...c, ...editForm }] : [k, c]); setLocalCats(newCats); setEditId(null); };
            const addNew = () => { const id = 'custom_' + Date.now(); setLocalCats([...localCats, [id, { label: '新類別', icon: 'Star', color: '#888888' }]]); setEditId(id); setEditForm({ label: '新類別', color: '#888888', icon: 'Star' }); };
            const handleSaveAll = () => { const finalObj = {}; localCats.forEach(([key, val], index) => { finalObj[key] = { ...val, order: index + 1 }; }); onSave(finalObj); onClose(); };

            return (
